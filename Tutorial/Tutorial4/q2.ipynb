   "source": [
    "#2. Read an Excel file containing employee records and list all employees in a specific department"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "e4baef6e",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "3bdb8ba6",
   "metadata": {},
   "outputs": [],
   "source": [
    "df=pd.read_excel('employee_Data.xlsx')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "cca80faa",
   "metadata": {},
   "outputs": [],
   "source": [
    "dept=\"BCT\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "b7e775ac",
   "metadata": {},
   "outputs": [],
   "source": [
    "employees=df[df[\"Department\"]==dept]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "9dc9e92a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "   EmpID  Name Department  Salary\n",
      "0    101   Ram        BCT   10000\n",
      "3    104  Sita        BCT   33434\n"
     ]
    }
   ],
   "source": [
    "print(employees)"
   ]
  },
